# ==============================================================================
# PHILOZZ Portfolio & CMS — Environment Configuration
# Phase 16B: Firebase Authentication & Admin Authorization
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CLIENT FIREBASE CONFIGURATION (Publicly visible in browser)
# Obtain these values from your Firebase Project Console -> Project Settings -> General
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyYourClientApiKeyPlaceholder"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="philozz-portfolio.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="philozz-portfolio"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="philozz-portfolio.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
NEXT_PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890abcdef"

# ------------------------------------------------------------------------------
# 2. SERVER FIREBASE ADMIN CONFIGURATION (Strictly private — server-only)
# Obtain from Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key
# NEVER expose these in client bundles, Git commits, or public repositories.
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID="philozz-portfolio"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@philozz-portfolio.iam.gserviceaccount.com"
# Note: For FIREBASE_PRIVATE_KEY, preserve literal newlines or use \n formatting:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. STRICT SINGLE-OWNER ACCESS CONTROL & SESSION POLICY (MANDATORY)
# PHILOZZ enforces strict dual-layer authorization:
# 1. Custom claim admin === true
# 2. Exact Firebase UID matching ADMIN_OWNER_UID
# If ADMIN_OWNER_UID is absent, privileged admin access is strictly rejected.
# ------------------------------------------------------------------------------
ADMIN_OWNER_UID="your-firebase-auth-owner-uid"
ADMIN_OWNER_EMAIL="felopater455@gmail.com"

# Cookie name for server-side Firebase session (default: __session for Firebase/Cloud Run compatibility)
SESSION_COOKIE_NAME="__session"

# Session duration in days (max 14 days per Firebase Admin SDK constraints, recommended 5 days)
SESSION_EXPIRY_DAYS="5"

# Expected site origin for CSRF enforcement on session endpoints
NEXT_PUBLIC_SITE_URL="https://philozz.com"

# ------------------------------------------------------------------------------
# 4. MEDIA STORAGE & IMAGEKIT CONFIGURATION
# ------------------------------------------------------------------------------
MEDIA_STORAGE_PROVIDER="imagekit"
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT="https://ik.imagekit.io/your_account"
NEXT_PUBLIC_IMAGEKIT_PUBLIC_KEY="public_xxxxxxxxxxxxxxxxxxxxxx="
IMAGEKIT_PRIVATE_KEY="private_xxxxxxxxxxxxxxxxxxxxxx="

